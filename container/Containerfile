# ── Builder ──────────────────────────────────────────────
FROM docker.io/library/alpine:3.20 AS builder

# Install build dependencies and Go 1.26.1
RUN apk add --no-cache git ca-certificates curl tar

# Install Go 1.26.1 manually
RUN curl -L https://go.dev/dl/go1.26.1.linux-amd64.tar.gz | tar -C /usr/local -xzf - && \
    ln -sf /usr/local/go/bin/go /usr/local/bin/go && \
    ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt

ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOTOOLCHAIN=local

WORKDIR /build

# Cache dependencies
COPY go.mod go.sum ./
COPY submodules/ submodules/
RUN go mod download

# Build binary
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o helixllm ./cmd/helixllm

# ── Runtime ──────────────────────────────────────────────
FROM docker.io/library/alpine:3.20

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /build/helixllm /usr/local/bin/helixllm

EXPOSE 8443/tcp 8443/udp

ENTRYPOINT ["helixllm"]
CMD ["--mode=full"]
