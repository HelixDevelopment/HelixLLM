# Local faster-whisper CPU Speech-To-Text (STT) service — rootless podman.
# §11.4.161 rootless container runtime; §11.4.76 containerization (booted via
# the containers submodule compose.Orchestrator, never hand-run `podman run`).
#
# Engine choice (§11.4.150 deep multi-angle research, see repo-root
# docs/qa/phase3_whisper_stt_20260707/RESULTS.md for the full citation trail):
# faster-whisper (CTranslate2) over whisper.cpp (ggml) for this CPU capability.
# Both run the identical Whisper weights (same accuracy); CTranslate2 int8 on
# CPU is ~2x faster than reference Whisper with no accuracy loss, and this
# exact engine/model/compute-type combination was ALREADY proven working on
# this host in docs/qa/p3_whisper_stt/ (§11.4.74 extend-don't-reimplement —
# reuse the proven artifact rather than re-deriving a whisper.cpp/ggml path
# that would add a second, less-integrated model format for no CPU-accuracy
# benefit). CPU device is deliberate: the GPU is reserved for the main-stream
# fleet-model proof (helixllm-coder, :18434).
FROM python:3.11-slim

# ffmpeg is required by faster-whisper for audio decoding (any input format).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

# CPU-only wheels. faster-whisper pulls ctranslate2 + onnxruntime (Silero VAD).
RUN pip install --no-cache-dir \
      "faster-whisper==1.1.1" \
      "huggingface-hub==0.28.1" \
      "requests==2.32.3" \
      "fastapi==0.115.6" \
      "uvicorn==0.34.0" \
      "python-multipart==0.0.20" \
      "PyYAML==6.0.2"

# NOTE (T079 / FR-056): the former `WHISPER_MODEL=base` default is GONE on
# purpose. A configuration value naming the model to run is exactly the static
# selection this feature replaces. The model is now resolved by
# stt_catalogue_wiring from the MEASURED host and the declared usage purpose
# over the catalogue mounted at HELIXLLM_CATALOGUE_PATHS; when nothing can be
# chosen the server reports why and refuses, rather than starting `base`.
#
# WHISPER_DEVICE / WHISPER_COMPUTE_TYPE remain available as operator PINS and
# are intentionally left unset so the wiring derives them from the host —
# pinning a device or a numeric precision is not naming a model.
ENV WHISPER_NO_SPEECH_THRESHOLD=0.6 \
    HELIXLLM_CATALOGUE_PATHS=/app/catalogue/speech_audio.yaml \
    HELIXLLM_USAGE_PURPOSE=commercial \
    HELIXLLM_WEIGHTS_DIR=/models \
    HF_HOME=/models/hf \
    OMP_NUM_THREADS=4

WORKDIR /app
COPY helix_model_gate.py /app/helix_model_gate.py
COPY stt_catalogue_wiring.py /app/stt_catalogue_wiring.py
COPY whisper_stt_server.py /app/app.py

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --retries=10 \
  CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
