# ── llama.cpp CUDA Router Builder ────────────────────────
# Builds llama.cpp from source with CUDA acceleration, RPC support,
# and router mode for multi-model serving across distributed hosts.

FROM docker.io/nvidia/cuda:12.6.3-devel-ubuntu24.04 AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    git \
    build-essential \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Clone llama.cpp (shallow clone for speed)
WORKDIR /src
RUN git clone --depth 1 https://github.com/ggml-org/llama.cpp.git .

# Build with CUDA acceleration, FA all quants, and RPC support for distributed inference
# -DGGML_CUDA=ON              enables CUDA GPU backend
# -DGGML_CUDA_FA_ALL_QUANTS=ON enables Flash Attention for all quantization types
# -DGGML_NATIVE=OFF            disables host-specific CPU optimizations (portable binary)
# -DGGML_RPC=ON               enables the RPC backend for multi-host distribution
# -DBUILD_SHARED_LIBS=OFF      static linking for self-contained binaries
RUN cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DGGML_CUDA=ON \
    -DGGML_CUDA_FA_ALL_QUANTS=ON \
    -DGGML_NATIVE=OFF \
    -DGGML_RPC=ON \
    -DBUILD_SHARED_LIBS=OFF

RUN cmake --build build --config Release --target llama-server --target llama-cli --target rpc-server -j$(nproc)

# ── Runtime ─────────────────────────────────────────────
FROM docker.io/nvidia/cuda:12.6.3-runtime-ubuntu24.04

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy built binaries from builder stage
COPY --from=builder /src/build/bin/llama-server /usr/local/bin/llama-server
COPY --from=builder /src/build/bin/llama-cli /usr/local/bin/llama-cli

# Copy RPC server binary (name varies by llama.cpp version)
RUN --mount=from=builder,source=/src/build/bin,target=/builder-bin \
    cp /builder-bin/llama-rpc-server /usr/local/bin/rpc-server 2>/dev/null || \
    cp /builder-bin/rpc-server /usr/local/bin/rpc-server 2>/dev/null || \
    cp /builder-bin/ggml-rpc-server /usr/local/bin/rpc-server 2>/dev/null || \
    echo "RPC server binary not found — RPC worker mode unavailable"

# Create models and config directories
RUN mkdir -p /models /config

# HTTP server port
EXPOSE 8080
# RPC port for distributed inference
EXPOSE 50052

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -sf http://localhost:8080/health || exit 1

# Router mode environment defaults
ENV HELIX_MODELS_MAX=3
ENV HELIX_THREADS=14
ENV HELIX_THREADS_BATCH=16

ENTRYPOINT ["llama-server"]
CMD ["--host", "0.0.0.0", \
     "--port", "8080", \
     "--models-dir", "/models", \
     "--models-max", "3", \
     "--models-autoload", \
     "--threads", "14", \
     "--threads-batch", "16", \
     "--metrics"]
