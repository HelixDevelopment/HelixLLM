# ── llama.cpp CUDA Router Builder ────────────────────────
# Builds llama.cpp from source with CUDA acceleration, RPC support,
# and router mode for multi-model serving across distributed hosts.

# CUDA 12.8 — the first CUDA branch with Blackwell sm_120 support; matches the host
# driver (570.169 / CUDA 12.8). 12.6.x does NOT build native sm_120 kernels for the RTX 5090.
FROM docker.io/nvidia/cuda:12.8.1-devel-ubuntu24.04 AS builder

# Build dependencies. libcurl4-openssl-dev + libssl-dev enable HTTPS GGUF download (-hf);
# without OpenSSL, `-hf` fails at runtime with "HTTPS is not supported" (verified 2026-07-06).
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    git \
    build-essential \
    pkg-config \
    libcurl4-openssl-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# CUDA driver STUB for BUILD-time linking of the driver VMM API (cuMemCreate/cuMemMap/…).
# ggml-cuda links libcuda; the -devel image ships only a stub `libcuda.so` (real libcuda.so.1
# is injected at RUNTIME by the GPU driver via CDI). Symlink the stub to its SONAME + put the
# stubs dir on the linker path so the static link resolves (verified fix 2026-07-06).
RUN ln -sf /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1
ENV LIBRARY_PATH=/usr/local/cuda/lib64/stubs

# Clone LATEST llama.cpp from upstream (bleeding edge, per operator mandate).
WORKDIR /src
RUN git clone --depth 1 https://github.com/ggml-org/llama.cpp.git .

# Max-performance Blackwell sm_120 build (bleeding edge):
# -DGGML_CUDA=ON                    CUDA GPU backend
# -DCMAKE_CUDA_ARCHITECTURES=120    native Blackwell sm_120 SASS (no PTX JIT) — REQUIRED for RTX 5090
# -DGGML_CUDA_F16=ON                half-precision CUDA compute path (faster on modern GPUs)
# -DGGML_CUDA_FA_ALL_QUANTS=ON      Flash Attention kernels for all quantization types
# -DGGML_LTO=ON                     link-time optimization (verified as a real, wired
#                                    CMake option: ggml/CMakeLists.txt:124 `option(GGML_LTO ...)`,
#                                    consumed at ggml/src/CMakeLists.txt:58 `if (GGML_LTO)` —
#                                    not a no-op flag; checked against the pinned local
#                                    dependencies/LLama_CPP mirror 2026-07-06)
# -DGGML_RPC=ON                     RPC backend for multi-host distributed inference
# -DGGML_NATIVE=OFF                 portable CPU binary (container may move hosts)
# -DLLAMA_CURL=ON -DLLAMA_OPENSSL=ON  HTTPS GGUF download (-hf) — requires libssl-dev above
# -DBUILD_SHARED_LIBS=OFF           static, self-contained binaries
RUN cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DGGML_CUDA=ON \
    -DCMAKE_CUDA_ARCHITECTURES=120 \
    -DGGML_CUDA_F16=ON \
    -DGGML_CUDA_FA_ALL_QUANTS=ON \
    -DGGML_LTO=ON \
    -DGGML_RPC=ON \
    -DGGML_NATIVE=OFF \
    -DLLAMA_CURL=ON \
    -DLLAMA_OPENSSL=ON \
    -DBUILD_SHARED_LIBS=OFF \
    -DCMAKE_EXE_LINKER_FLAGS="-Wl,-rpath-link,/usr/local/cuda/lib64/stubs"

# NOTE: in latest llama.cpp the RPC server target is `ggml-rpc-server`
# (tools/rpc/CMakeLists.txt: set(TARGET ggml-rpc-server)), gated on GGML_RPC=ON — NOT the
# old `rpc-server` name. It produces build/bin/ggml-rpc-server.
RUN cmake --build build --config Release \
      --target llama-server --target llama-cli --target ggml-rpc-server -j$(nproc) \
 && test -x build/bin/llama-server && test -x build/bin/llama-cli && test -x build/bin/ggml-rpc-server \
 && echo "BUILD OK: sm_120 static llama-server + llama-cli + ggml-rpc-server"

# ── Runtime ─────────────────────────────────────────────
# CUDA 12.8 runtime to match the sm_120 build. The real libcuda.so.1 (driver) is injected
# at runtime by CDI via `podman run --device nvidia.com/gpu=all`.
FROM docker.io/nvidia/cuda:12.8.1-runtime-ubuntu24.04

# Install minimal runtime dependencies: libgomp1 for OpenMP; curl for healthcheck;
# libcurl4 + libssl3 explicitly (belt-and-suspenders alongside the `curl` package —
# the binary was linked against libcurl/libssl at build time via -DLLAMA_CURL=ON
# -DLLAMA_OPENSSL=ON, so the runtime image must ship matching shared libs even
# though `curl` usually pulls them in transitively).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libcurl4 \
    libssl3 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy built binaries from builder stage
COPY --from=builder /src/build/bin/llama-server /usr/local/bin/llama-server
COPY --from=builder /src/build/bin/llama-cli /usr/local/bin/llama-cli

# Copy the RPC server binary. The builder stage above ONLY builds `ggml-rpc-server`
# (tools/rpc/CMakeLists.txt: set(TARGET ggml-rpc-server), gated on GGML_RPC=ON) —
# `llama-rpc-server` / `rpc-server` are stale names from older llama.cpp releases and
# will never exist in this build's output. Hard-fail (not `2>/dev/null || echo warn`)
# if the binary is missing so a future upstream rename never SILENTLY drops RPC worker
# mode from the shipped image (§11.4.108 artifact-layer verification / §11.4.122
# no-silent-capability-loss) — the previous three-way fallback + warning-only echo
# masked exactly this failure mode.
RUN --mount=from=builder,source=/src/build/bin,target=/builder-bin \
    cp /builder-bin/ggml-rpc-server /usr/local/bin/rpc-server || \
    { echo "FATAL: ggml-rpc-server not found in build output — RPC worker mode would be silently missing from the shipped image"; exit 1; }

# Create models and config directories
RUN mkdir -p /models /config

# HTTP server port
EXPOSE 8080
# RPC port for distributed inference
EXPOSE 50052

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -sf http://localhost:8080/health || exit 1

# Router mode environment defaults
ENV HELIX_MODELS_MAX=3
ENV HELIX_THREADS=14
ENV HELIX_THREADS_BATCH=16

ENTRYPOINT ["llama-server"]
CMD ["--host", "0.0.0.0", \
     "--port", "8080", \
     "--models-dir", "/models", \
     "--models-max", "3", \
     "--models-autoload", \
     "--threads", "14", \
     "--threads-batch", "16", \
     "--metrics"]
