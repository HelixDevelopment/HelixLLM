# ── llama.cpp Builder ───────────────────────────────────
# Builds llama.cpp from source with CPU optimizations and RPC support
# for distributed inference across multiple hosts.
# Includes automatic model download and server startup.

FROM docker.io/library/alpine:3.20 AS builder

# Install build dependencies
RUN apk add --no-cache \
    git \
    cmake \
    build-base \
    g++ \
    gcc \
    linux-headers

# Clone llama.cpp (shallow clone for speed)
WORKDIR /src
RUN git clone --depth 1 https://github.com/ggml-org/llama.cpp.git .

# Build with CPU optimizations AND RPC support for distributed inference
# -DGGML_RPC=ON enables the RPC backend for multi-host distribution
RUN cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DLLAMA_NATIVE=OFF \
    -DLLAMA_AVX=ON \
    -DLLAMA_AVX2=ON \
    -DLLAMA_AVX512=OFF \
    -DLLAMA_FMA=ON \
    -DLLAMA_F16C=ON \
    -DLLAMA_STATIC=OFF \
    -DBUILD_SHARED_LIBS=OFF \
    -DGGML_RPC=ON

RUN cmake --build build --config Release -j$(nproc)

# ── Runtime ─────────────────────────────────────────────
FROM docker.io/library/alpine:3.20

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    curl \
    wget \
    libstdc++ \
    libgomp

# Copy built binaries (server, cli, and any rpc binaries for distributed inference)
COPY --from=builder /src/build/bin/llama-server /usr/local/bin/llama-server
COPY --from=builder /src/build/bin/llama-cli /usr/local/bin/llama-cli

# Copy RPC server binary if it was built (name varies by llama.cpp version)
# Using a RUN step since COPY doesn't support optional files
RUN --mount=from=builder,source=/src/build/bin,target=/builder-bin \
    cp /builder-bin/llama-rpc-server /usr/local/bin/rpc-server 2>/dev/null || \
    cp /builder-bin/rpc-server /usr/local/bin/rpc-server 2>/dev/null || \
    cp /builder-bin/ggml-rpc-server /usr/local/bin/rpc-server 2>/dev/null || \
    echo "RPC server binary not found — RPC worker mode unavailable"

# Create models directory
RUN mkdir -p /models

# Copy startup scripts
COPY container/scripts/download-model.sh /usr/local/bin/download-model
COPY container/scripts/start-server.sh /usr/local/bin/start-server
RUN chmod +x /usr/local/bin/download-model /usr/local/bin/start-server

EXPOSE 8080
# RPC port for distributed inference
EXPOSE 50052

ENTRYPOINT ["/usr/local/bin/start-server"]
