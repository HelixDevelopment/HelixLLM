# HelixLLM API Server Environment Configuration
# ==============================================
# Copy this file to .env and customize for your deployment

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Host to bind the server (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
HELIXLLM_HOST=0.0.0.0

# Port to listen on
HELIXLLM_PORT=8000

# API Key for authentication (leave empty to disable authentication)
# Generate a secure key with: openssl rand -hex 32
HELIXLLM_API_KEY=

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Model identifier (must match what CLI agents expect)
HELIXLLM_MODEL=helix-llm

# Model version
HELIXLLM_VERSION=1.0.0

# Maximum tokens per request
HELIXLLM_MAX_TOKENS=4096

# Default temperature (0.0 - 2.0)
HELIXLLM_TEMPERATURE=0.7

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable streaming responses (SSE)
HELIXLLM_ENABLE_STREAMING=true

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
HELIXLLM_LOG_LEVEL=INFO

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed origins for CORS (comma-separated, * for all)
HELIXLLM_CORS_ORIGINS=*

# Examples:
# HELIXLLM_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# HELIXLLM_CORS_ORIGINS=https://app.example.com

# =============================================================================
# RATE LIMITING (Optional)
# =============================================================================

# Enable rate limiting
HELIXLLM_RATE_LIMIT=false

# Maximum requests per window per IP
HELIXLLM_RATE_LIMIT_REQUESTS=100

# Rate limit window in seconds
HELIXLLM_RATE_LIMIT_WINDOW=60

# =============================================================================
# MONITORING (Optional - for docker-compose monitoring profile)
# =============================================================================

# Grafana admin password
GRAFANA_PASSWORD=admin

# =============================================================================
# CLI AGENT CONFIGURATION
# =============================================================================

# These variables are used by CLI agents to connect to HelixLLM
# Add these to your shell profile (e.g., ~/.bashrc, ~/.zshrc)

# OpenCode
# OPENCODE_API_KEY=${HELIXLLM_API_KEY}
# OPENCODE_API_BASE_URL=http://localhost:${HELIXLLM_PORT}/v1
# OPENCODE_MODEL=${HELIXLLM_MODEL}

# Crush
# CRUSH_API_KEY=${HELIXLLM_API_KEY}
# CRUSH_API_BASE_URL=http://localhost:${HELIXLLM_PORT}/v1
# CRUSH_MODEL=${HELIXLLM_MODEL}

# Gemini CLI
# GEMINI_API_KEY=${HELIXLLM_API_KEY}
# GEMINI_API_BASE_URL=http://localhost:${HELIXLLM_PORT}/v1
# GEMINI_MODEL=${HELIXLLM_MODEL}

# Claude Code
# ANTHROPIC_API_KEY=${HELIXLLM_API_KEY}
# ANTHROPIC_BASE_URL=http://localhost:${HELIXLLM_PORT}/v1
# CLAUDE_CODE_MODEL=${HELIXLLM_MODEL}
